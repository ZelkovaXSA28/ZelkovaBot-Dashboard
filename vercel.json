{
  "version": 2,
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "http://78.154.103.43:9907/socket.io/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://78.154.103.43:9907/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://78.154.103.43:9907/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/socket.io/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}