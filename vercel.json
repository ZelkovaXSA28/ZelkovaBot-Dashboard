{
  "version": 2,
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "http://node.ravenhost.space:19220/socket.io/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://node.ravenhost.space:19220/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://node.ravenhost.space:19220/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/socket.io/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
